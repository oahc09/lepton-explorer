{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinFinder",
  "version": "0.1.0",
  "identifier": "com.winfinder.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WinFinder",
        "width": 800,
        "height": 600,
        "minWidth": 520,
        "minHeight": 320,
        "decorations": false,
        "windowEffects": { "effects": ["mica"], "state": "active" }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
